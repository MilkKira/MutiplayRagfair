[Unit]
Description=CrossRagfair flea-market hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crossragfair
Group=crossragfair
WorkingDirectory=/opt/crossragfair-hub
EnvironmentFile=-/etc/crossragfair/hub.env
ExecStart=/usr/bin/dotnet /opt/crossragfair-hub/CrossRagfair.Hub.dll
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/crossragfair

[Install]
WantedBy=multi-user.target
