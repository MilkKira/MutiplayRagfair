CrossRagfairHub__ListenUrl=http://127.0.0.1:7443
CrossRagfairHub__DataDirectory=/var/lib/crossragfair
CrossRagfairHub__AllowedClockSkewSeconds=30
CrossRagfairHub__OriginCommandTimeoutMilliseconds=2500
CrossRagfairHub__PeerSecrets__server_a=replace-with-at-least-32-random-characters
CrossRagfairHub__PeerSecrets__server_b=replace-with-another-32-character-secret
